# ============================================================================
# EcoCity Backend — variables d'environnement
# Copiez ce fichier en .env et ajustez les valeurs selon votre environnement.
# ============================================================================

# --- Application ------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
PUBLIC_URL=http://localhost:3000
# Origines autorisées pour le CORS, séparées par des virgules
CORS_ORIGINS=http://localhost:4200

# --- Base de données ---------------------------------------------------------
# Doit correspondre aux identifiants du docker-compose.yml fourni (postgres/ecocity)
DATABASE_URL=postgresql://ecocity:ecocity@localhost:5432/ecocity?schema=public

# --- JWT ----------------------------------------------------------------------
# Générez des secrets forts en production, p. ex. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Sécurité -------------------------------------------------------------
BCRYPT_SALT_ROUNDS=10

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# --- Seed (compte Super Admin créé par `npm run prisma:seed`) ---------------
SEED_SUPER_ADMIN_EMAIL=admin@ecocity.app
SEED_SUPER_ADMIN_PASSWORD=EcoCity2026!
